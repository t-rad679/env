#!/bin/sh
# Start i3 the way a display manager would -- with ~/.xprofile sourced first.
#
# Installed as /usr/local/bin/i3-xsession (a symlink back into this repo, made
# by machines/laptop/init.zsh) and pointed at by the Exec= of
# machines/laptop/xsessions/i3-xprofile.desktop.
#
# Why this exists
# ---------------
# ~/.xprofile is a *display manager* convention, not an X one. LightDM sources
# it; greetd does not, and neither does the path noctalia-greeter takes to
# start an X session. That path is `startx <wm>` (see
# /usr/bin/noctalia-greeter-xsession), and startx only falls back to
# ~/.xinitrc / /etc/X11/xinit/xinitrc when it is given *no* client -- with an
# explicit one it execs it directly and reads neither. So picking the stock
# "i3" entry from the greeter starts an i3 with no ~/.xprofile at all:
#
#   * MACHINE_ROLE is never exported, so config/i3/config falls through to
#     ${MACHINE_ROLE:-desktop} and the laptop silently loads the DESKTOP role;
#   * `autorandr --change` never runs, so the dock's monitors stay in the
#     connected-but-disabled half-state that machines/laptop/xprofile.sh exists
#     to prevent (the amdgpu hotplug-IRQ storm);
#   * machines/laptop/bin/monitor-output never publishes the X resources that
#     the `workspace N output` rules in machines/laptop/i3/laptop.conf read,
#     so every workspace opens on whichever monitor it feels like.
#
# Sourcing ~/.xprofile here puts all of that back, and `exec` keeps i3 as the
# session leader so the session ends when i3 does.
#
# POSIX sh, not zsh, despite the repo's zsh-only rule. This file sources
# ~/.xprofile into itself, and that file -- plus the machines/<role>/xprofile.sh
# fragment it in turn sources -- is written as POSIX sh for LightDM's sake.
# Running it under zsh would subject someone else's sh to zsh's word-splitting
# rules. Same deliberate exception, and the same reason, as config/.xprofile.

if [ -r "$HOME/.xprofile" ]; then
    . "$HOME/.xprofile"
fi

# "$@" so a variant entry can pass i3 flags (the stock package ships an
# "i3 (with debug log)" session that does exactly that).
exec i3 "$@"
