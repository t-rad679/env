#!/usr/bin/zsh

# Build the 2x2 chat grid -- Messenger, Messages, Signal and Discord -- in
# whichever session is actually running.
#
# Usage: chat-grid             launch the apps and build the grid
#        chat-grid --regrid    rebuild the grid from the windows already open
#
#     Messenger | Messages
#     ----------+---------
#     Signal    | Discord
#
# This is only the dispatcher. The work is in bin/chat-grid-i3 and
# bin/chat-grid-niri, which do the same job in i3 and niri respectively and are
# genuinely different scripts rather than two branches of one: i3 reserves the
# corners up front with a saved layout appended before the apps start, niri has
# no append_layout and arranges the live windows every run. Their headers carry
# the reasoning; this file only decides which of them to run.
#
# The spellbook can boot either session, so the bare name has to work in both.
# Both configs call their half directly -- i3/autostart.conf execs chat-grid-i3,
# niri/role.kdl spawns chat-grid-niri -- because at login the session is already
# known and probing for it would only add a way to get it wrong. This exists for
# the other caller: a hand-run `chat-grid --regrid` after dragging the grid
# apart, where remembering which compositor you are in is exactly the thing not
# worth doing.
#
# It asks the compositors rather than reading $WAYLAND_DISPLAY, which is the
# opposite of how `clip` in config/zsh/env/alias.zsh picks wl-copy over xclip.
# The difference is what the question is. `clip` only needs to know which
# protocol it is talking, and both of its tools are installed either way. Here
# the question is which compositor will accept IPC, and that is not the same as
# which display protocol is in use: a niri that is installed but not running
# answers neither, and so does a tty or a systemd user unit that inherited no
# session at all. Both halves open by making this exact check and refusing
# without it, so asking here costs one round trip and removes the guess.
#
# Order is not load-bearing -- an i3 session cannot be running inside a niri one
# or the reverse, so at most one probe can succeed.

set -u

local -r SELF="${0:t}"

# :A, not just :h -- resolve this file to its real path before taking the
# directory, so the halves are still found next to it when chat-grid is reached
# through a symlink (~/bin, a .desktop entry) rather than through PATH.
local -r HERE="${0:A:h}"

# No argument parsing here on purpose: each half already validates its own and
# prints its own usage, and `exec` means a rejection names the script that
# rejected it instead of this one. That is the more useful name anyway -- it is
# what the error is about, and it is on PATH too.
#
# exec also keeps this out of the process tree entirely, so the half's exit
# status is this script's with nothing to forward, and `${0:t}` inside it
# reports its own name in the messages it prints.
if niri msg -j version >/dev/null 2>&1; then
    exec "$HERE/chat-grid-niri" "$@"
fi

if i3-msg -t get_version >/dev/null 2>&1; then
    exec "$HERE/chat-grid-i3" "$@"
fi

print -u2 "$SELF: neither niri nor i3 is answering; nothing to build a grid in"
print -u2 "$SELF: run it from inside the session -- a tty, an ssh login or a"
print -u2 "$SELF: systemd user unit has no compositor to talk to"
exit 1
