#!/usr/bin/zsh

# Workspace 8 on the laptop: Spotify on the left and a kitty directly to its
# right. laptop.conf pins ws8 to the built-in panel (eDP).
#
# Usage: ws8-spotify [--term] [--no-focus]
#
#   Starts whichever of the two windows is missing, then focuses Spotify (which
#   switches to ws8). If both are already up, it only focuses. --no-focus is
#   for the login autostart.
#
#   --term is the terminal half on its own: it starts the kitty only if it is
#   missing, placed beside Spotify exactly as at login, and focuses the terminal
#   rather than Spotify. It never launches Spotify. This is what the "Spotify
#   Terminal" Ulauncher entry runs, for when the terminal has been closed but
#   Spotify is still up.
#
# Why a script instead of i3 `assign`s: the terminal is placed relative to
# Spotify, not just onto the workspace. Spotify also sets WM_CLASS only after
# it maps its window, so an `assign` on class "Spotify" can miss it. The script
# waits for the window by class and marks it "spotify" instead. Same shape as
# machines/laptop/bin/obsidian-grimoire and chrome-workspace.

set -u

local -r WS="8"
local -r SPOTIFY_CLASS="Spotify"
local -r SPOTIFY_MARK="spotify"
local -r TERM_CLASS="ws8-term"
local -r TERM_MARK="ws8-term"
local -r TERM_DIR="$HOME"
# The terminal's share of the split: golden ratio 1.618:1 is 38.2/61.8, and
# i3's ppt is whole percent -- the same rounding as the $mod+r `g` binding in
# config/i3/conf.d/baseconfig.conf.
local -r TERM_PPT="38"
# Spotify can be slow on a cold login; give each window 30s to map.
local -ri TRIES=60

local -r usage="usage: ${0:t} [--term] [--no-focus]"

local -i focus=1 term_only=0
while (( $# )); do
    case "$1" in
        --term)     term_only=1 ;;
        --no-focus) focus=0 ;;
        *)          print -u2 "$usage"; exit 2 ;;
    esac
    shift
done

has_mark() {
    [[ -n "$(i3-msg -t get_tree | jq -r --arg m "$1" \
        '.. | objects | select((.marks // []) | index($m)) | .id')" ]]
}

# Wait for a window of class $1 that doesn't have a mark yet, then mark it $2
# and move it to ws8. Unmarked only, so an already marked window is never
# picked up a second time.
adopt_window() {
    local class="$1" mark="$2"
    local -i i
    local win=""
    for (( i = 0; i < TRIES; i++ )); do
        win="$(i3-msg -t get_tree | jq -r --arg c "$class" \
            'first(.. | objects | select(.window != null
                and .window_properties.class == $c
                and ((.marks // []) | length) == 0) | .window) // empty')"
        [[ -n "$win" ]] && break
        sleep 0.5
    done

    if [[ -z "$win" ]]; then
        print -u2 "${0:t}: no $class window appeared within $(( TRIES / 2 ))s"
        return 1
    fi

    # Moving to a workspace that does not exist yet creates it, and i3 creates
    # it on its assigned output (eDP, from laptop.conf).
    i3-msg -q "[id=$win] mark --add $mark, move container to workspace number $WS"
}

start_spotify() {
    # setsid so the app survives whatever launched this -- same reasoning as
    # machines/laptop/bin/chat-grid. If Spotify is already running without the
    # mark (e.g. after an i3 restart), this launch hands off to it and exits,
    # and adopt_window finds the running window anyway.
    setsid -f spotify >/dev/null 2>&1
    adopt_window "$SPOTIFY_CLASS" "$SPOTIFY_MARK"
}

start_term() {
    setsid -f kitty --class "$TERM_CLASS" --directory "$TERM_DIR" >/dev/null 2>&1
    adopt_window "$TERM_CLASS" "$TERM_MARK"
}

# `move container to mark` puts the terminal right after Spotify in Spotify's
# split, which is to its right because ws8 on a landscape panel splits
# horizontally. The resize then sets the terminal against its sibling, which is
# exactly the golden ratio only when the two of them are the whole split (as at
# login).
#
# Under --term Spotify may not be running, and then there is no mark to move
# to. adopt_window has already put the terminal on ws8, so leave it owning the
# workspace until Spotify joins it.
arrange_term() {
    has_mark "$SPOTIFY_MARK" || return 0
    i3-msg -q "[con_mark=\"^${TERM_MARK}\$\"] move container to mark $SPOTIFY_MARK, resize set width $TERM_PPT ppt"
}

# --term: the terminal half on its own, for relaunching just the kitty.
if (( term_only )); then
    if ! has_mark "$TERM_MARK"; then
        start_term || exit 1
        arrange_term || exit 1
    fi
    if (( focus )); then
        i3-msg -q "[con_mark=\"^${TERM_MARK}\$\"] focus"
    fi
    exit 0
fi

# Only arrange when something was just started. Re-running this to jump to ws8
# must not undo a layout you changed by hand.
local -i started=0
if ! has_mark "$SPOTIFY_MARK"; then
    start_spotify || exit 1
    started=1
fi
if ! has_mark "$TERM_MARK"; then
    start_term || exit 1
    started=1
fi

if (( started )); then
    arrange_term || exit 1
fi

if (( focus )); then
    i3-msg -q "[con_mark=\"^${SPOTIFY_MARK}\$\"] focus"
fi
