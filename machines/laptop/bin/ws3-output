#!/usr/bin/zsh

# Pin workspace 3 (the chat grid) to the ViewSonic monitor on the dock.
#
# Usage: ws3-output        (no arguments; a no-op when undocked)
#
# Why this is a script and not `workspace $ws3 output DisplayPort-7` in the i3
# config: this laptop's DisplayPort connector numbers are NOT stable across
# reboots -- the same two dock monitors come up as DisplayPort-6=ViewSonic /
# DisplayPort-7=Samsung on one boot and the exact reverse on the next. That is
# the same hazard machines/laptop/autorandr/settings.ini sets `match-edid=1`
# for. A connector name baked into the config would land the chat grid on the
# Samsung roughly half the time, so the connector is resolved here, at run
# time, from the monitor's EDID instead.
#
# Called from two places, because neither covers both cases on its own:
#   * machines/laptop/bin/chat-grid, which i3 execs at login. At login
#     ~/.xprofile runs `autorandr --change` BEFORE i3 exists, so the autorandr
#     hook below has no i3 to talk to yet.
#   * machines/laptop/autorandr/postswitch, for docking/undocking while
#     already logged in.
#
# Limitation worth knowing: i3 can only move a workspace that exists. If ws3
# has no windows when you dock, there is nothing to move and this exits
# quietly; the grid lands on the ViewSonic the next time chat-grid runs.

set -u

# EDID model name of the dock's ViewSonic VA2447-FHD. Matched against the
# monitor's raw EDID, so it has to be the string the panel actually reports
# (`autorandr --fingerprint`), not the marketing name.
local -r MONITOR_MODEL="VA2447-FHD"
local -r WS="3"

# No X, nothing to do. autorandr's hotplug units run outside a login session,
# so this is a real case, not paranoia.
if [[ -z "${DISPLAY:-}" ]]; then
    exit 0
fi

if ! command -v autorandr >/dev/null 2>&1; then
    print -u2 "${0:t}: autorandr not installed; cannot resolve $MONITOR_MODEL"
    exit 1
fi

# EDID stores the model as plain ASCII, so the connector can be found by
# looking for the hex encoding of the model name inside each output's
# fingerprint. Encoding the needle is cheaper -- and has fewer dependencies --
# than decoding every EDID.
local model_hex=""
local -i i
for (( i = 1; i <= ${#MONITOR_MODEL}; i++ )); do
    model_hex+="$(printf '%02x' "'${MONITOR_MODEL[i]}")"
done

# `autorandr --fingerprint` prints one "OUTPUT <edid-hex>" line per connected
# output, which is exactly the mapping needed here.
local line
line="$(autorandr --fingerprint 2>/dev/null | grep -i -m1 -- "$model_hex")"
if [[ -z "$line" ]]; then
    # Undocked, or the ViewSonic is unplugged. Workspace 3 falls to the only
    # output there is, which is already the right answer.
    exit 0
fi
local connector="${line%% *}"

# i3 may not be up yet (the login path calls this from .xprofile's autorandr
# before the WM starts). Not an error; the other caller will handle it.
if ! i3-msg -t get_version >/dev/null 2>&1; then
    exit 0
fi

local workspaces
workspaces="$(i3-msg -t get_workspaces)" || exit 1

# Nothing to move if the workspace has never been opened.
local ws_output
ws_output="$(print -r -- "$workspaces" | jq -r --arg ws "$WS" \
    '.[] | select(.name == $ws) | .output')"
if [[ -z "$ws_output" ]]; then
    exit 0
fi

# Already there. Worth checking: the move below has to steal focus, and
# autorandr fires this on every hotplug event.
if [[ "$ws_output" == "$connector" ]]; then
    exit 0
fi

# `move workspace to output` acts on the focused workspace, so focus has to go
# to ws3 and come back. --no-auto-back-and-forth keeps this from clobbering
# the workspace that $mod+Tab-style back-and-forth would return to.
local previous
previous="$(print -r -- "$workspaces" | jq -r '.[] | select(.focused) | .name')"

i3-msg -q "workspace --no-auto-back-and-forth $WS; move workspace to output $connector" || exit 1

if [[ -n "$previous" && "$previous" != "$WS" ]]; then
    i3-msg -q "workspace --no-auto-back-and-forth $previous"
fi
