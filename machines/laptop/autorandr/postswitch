#!/usr/bin/zsh

# autorandr hook: runs after every profile switch, including the udev/systemd
# hotplug path that fires on dock and undock.
#
# Re-pins workspace 3 (the chat grid) to the ViewSonic, which has to happen
# again after every switch: moving a workspace onto an output that autorandr
# then turns off leaves i3 to reshuffle it wherever it likes, so the pin does
# not survive a dock cycle on its own.
#
# ws3-output is a no-op when the ViewSonic is absent, when i3 is not running
# and when the workspace is already on the right output, so this is safe to
# fire on every event. Guarded on the script existing so a half-provisioned
# laptop still switches profiles cleanly.
#
# Repainting the wallpaper has to happen again too: the root pixmap is sized
# for the layout that was live when it was painted, so a newly enabled output
# comes up black and a resolution change leaves the old image unscaled.
#
# Global (not docked/postswitch or undocked/postswitch) on purpose: undocking
# matters as much as docking here, and a profile-specific hook would silently
# not run for the --default fallback.

set -u

local -r PIN="$HOME/src/env/machines/laptop/bin/ws3-output"
local -r WALLPAPER="$HOME/src/env/bin/wallpaper"

if [[ -x "$PIN" ]]; then
    "$PIN"
fi

if [[ -x "$WALLPAPER" ]]; then
    "$WALLPAPER"
fi
