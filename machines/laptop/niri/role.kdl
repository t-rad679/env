// Laptop-only niri config. Linked to ~/.config/niri/role.kdl by
// init/links.zsh and included by config/niri/config.kdl (which explains why
// the link exists instead of a $MACHINE_ROLE include pattern).
//
// Nothing in here may duplicate a key bound in config/niri/config.kdl: niri
// merges the two `binds` blocks but rejects the config outright on a
// duplicate keybind, which means a typo takes the whole session's config down
// to the last good version rather than just this file.

// The built-in panel. niri picks a scale from the EDID's physical size when
// none is given, and this panel -- 2560x1600 across 345x215mm, about 189 DPI
// -- lands close enough to the 2x threshold to be a coin flip. Pinning it to
// 1.0 keeps it looking exactly like it does under X, where nothing scales at
// all. Raise it to 1.25 or 1.5 if that turns out to be too small now that
// there is per-output scaling to be had.
//
// The connector name is stable for the internal panel (it is eDP-1 under DRM,
// the same way it is "eDP" under X), unlike the dock's DisplayPorts -- those
// enumerate as DP-7/DP-8 today and something else after the next dock cycle,
// so they are deliberately not configured here. niri can match an output by
// "make model serial" instead of connector, which is the EDID-keyed approach
// machines/laptop/bin/monitor-output takes under X; that is the way to pin
// the externals when the time comes.
output "eDP-1" {
    scale 1.0
}

binds {
    // F7 / F8. Laptop-only because the desktop has no /sys/class/backlight
    // device at all.
    //
    // Under i3 these go through machines/laptop/bin/brightness-step, which
    // exists to stop the backlight being walked down to a black screen.
    // Noctalia's own brightness control has that floor built in and shows an
    // OSD with it, so the script is not needed here -- it stays for the i3
    // session, which is still selectable from the greeter.
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }

    // F9, the external-display key. Under i3 this runs `autorandr --change
    // --force`; autorandr is an X program and does nothing useful here.
    // Wayland hotplug is the compositor's job and niri handles it natively,
    // so the key opens Noctalia's display settings instead -- the manual
    // "fix my displays" button, same role as before.
    XF86Display { spawn "noctalia" "msg" "settings-open"; }

    // The chat workspace (declared further down this file). By NAME, which
    // is the whole reason it has one: a name resolves globally, so this
    // reaches the workspace from any monitor, where `focus-workspace 2`
    // would mean "the second workspace on whichever monitor I am looking
    // at" and land somewhere different depending on where you started.
    //
    // Plain Mod+<letter>, not one of the Ctrl rows, because this is not a
    // directional move. The table in config/niri/config.kdl covers relative
    // motion -- focus/move a column, a window, a workspace, a monitor --
    // and jumping to a specific named place is not on it. It is the same
    // shape as Mod+D (launcher) and Mod+O (overview), which is the company
    // it keeps here.
    //
    // M because C is the control centre, and Messenger and Messages are two
    // of the four windows on it. Not Mod+3, which is where i3 had the chat
    // workspace and is the obvious muscle memory: a bare number in this
    // config means "the Nth workspace on the FOCUSED monitor", and making 3
    // alone a global jump would leave 1, 2 and 4 staying put while 3
    // teleports to another screen. (It would also be lying -- chat is the
    // SECOND workspace on its monitor, under Netflix.)
    //
    // Shift sends the focused column there instead of following it, which
    // is what Shift means on every other row of that table. The pair is
    // deliberately mnemonic rather than positional, so the obvious family
    // members stay available if the other scripted i3 workspaces ever move
    // over: G for the grimoire, S for Spotify, P and W for the two Chrome
    // profiles. All four, and their Shift pairs, are currently unbound.
    Mod+M hotkey-overlay-title="Chat workspace" { focus-workspace "chat"; }
    Mod+Shift+M hotkey-overlay-title="Move column to chat" { move-column-to-workspace "chat"; }

    // The other four named workspaces, same grammar as the chat pair above:
    // plain Mod jumps there, Mod+Shift sends the focused column there. All
    // by name, so they work from any monitor.
    //
    // W for WeftWorks and H for "home" -- the two Chrome profiles are a
    // work/home pair, which is a better mnemonic than the browser they share
    // anyway. P would have been the obvious letter for "personal", but
    // Mod+Shift+P is already power-off-monitors in config/niri/config.kdl,
    // and niri rejects the whole config on a duplicate bind. Taking Mod+P
    // and leaving Mod+Shift+P meaning something unrelated would be worse
    // than picking a letter whose pair is free, and re-binding a shared key
    // for a laptop-only workspace would be worse still.
    Mod+W hotkey-overlay-title="WeftWorks Chrome" { focus-workspace "weftworks"; }
    Mod+Shift+W hotkey-overlay-title="Move column to WeftWorks" { move-column-to-workspace "weftworks"; }

    Mod+H hotkey-overlay-title="Personal Chrome" { focus-workspace "personal"; }
    Mod+Shift+H hotkey-overlay-title="Move column to Personal" { move-column-to-workspace "personal"; }

    Mod+G hotkey-overlay-title="The Grimoire" { focus-workspace "grimoire"; }
    Mod+Shift+G hotkey-overlay-title="Move column to the Grimoire" { move-column-to-workspace "grimoire"; }

    Mod+S hotkey-overlay-title="Spotify" { focus-workspace "spotify"; }
    Mod+Shift+S hotkey-overlay-title="Move column to Spotify" { move-column-to-workspace "spotify"; }
}

// The chat workspace: Messenger, Messages, Signal and Discord in a 2x2 on
// the right-hand dock monitor, the niri half of what i3 gets from
// machines/laptop/i3/autostart.conf + i3/ws3-chat.json + bin/chat-grid.
//
// Named, not numbered, and that is the whole reason this works. niri
// workspaces are dynamic and per-monitor, so an index means "the Nth
// workspace on the FOCUSED monitor" -- `focus-workspace 2` lands somewhere
// different depending on where you were standing. A name is global: it
// resolves to this workspace on this monitor from anywhere, which is what
// lets the window rules below and bin/chat-grid-niri both address it without
// caring what is focused. (config/niri/config.kdl keeps Mod+1..9 on indices
// deliberately -- per-monitor is the right behaviour for a bare number.)
//
// A workspace declared here is also persistent: it exists even when empty,
// so the rules below always have somewhere to put things.
//
// open-on-output takes the EDID make/model/serial, not DP-8. Connector
// numbers on this laptop are NOT stable -- the dock renumbers its
// DisplayPorts between boots and even across a re-enumeration while logged
// in, which is the same hazard machines/laptop/autorandr/settings.ini sets
// match-edid=1 for and machines/laptop/bin/monitor-output resolves by hand
// under X. niri matches outputs this way natively, so here it costs one
// string and no helper script. The string is the whole of what `niri msg
// outputs` prints in quotes for the panel. When the monitor is absent niri
// falls back to the first output rather than failing, so an undocked session
// still has a chat workspace.
// Mod+M focuses it and Mod+Shift+M sends the focused column to it; both
// are in the binds block above, and both address it by this name.
workspace "chat" {
    open-on-output "Samsung Electric Company U32J59x HCJT503124"
}

// Route the four chat apps to it however they are started, the counterpart
// of the `assign` rules in machines/laptop/i3/autostart.conf. The rules fire
// on OPEN only, so a window that is already up and sitting elsewhere is not
// dragged back -- bin/chat-grid-niri does that part explicitly.
//
// Two app_id spellings each for the Chrome apps: under Wayland google-chrome
// ignores --class and builds app_id from the --app URL plus the profile,
// while under XWayland it honours --class and reports the same
// "messenger-chrome" / "messages-chrome" the i3 rules match. Both are listed
// so the routing survives commenting out ELECTRON_OZONE_PLATFORM_HINT in
// config/niri/config.kdl, which that file documents as the thing to try when
// an Electron app misbehaves. Keep these in step with GRID_APPID in
// machines/laptop/bin/chat-grid-niri.
//
// Signal and Discord report lowercase app_ids, not the capitalised names
// their .desktop files use -- same as their X11 classes.
window-rule {
    match app-id=r#"^chrome-www\.messenger\.com__-Default$"#
    match app-id=r#"^messenger-chrome$"#
    match app-id=r#"^chrome-messages\.google\.com__web-Default$"#
    match app-id=r#"^messages-chrome$"#
    match app-id=r#"^signal$"#
    match app-id=r#"^discord$"#
    open-on-workspace "chat"
}

// Build the 2x2 at login. The window rules above get the apps onto the
// workspace; niri has no saved-layout mechanism, so their arrangement on it
// has to be done imperatively afterwards -- see bin/chat-grid-niri.
//
// Spelled out in full rather than relying on PATH: niri inherits the
// systemd user environment, which has not sourced the zsh env scripts that
// put machines/$MACHINE_ROLE/bin on PATH.
//
// spawn-sh-at-startup, not spawn-at-startup, purely to get $HOME expanded.
// spawn-at-startup execs the command directly -- no shell, so neither `~`
// nor `$HOME` is expanded in its arguments and the only way to name the
// script would be an absolute path with a username in it. The two machines
// have different usernames, so nothing in this repo may do that.
spawn-sh-at-startup "$HOME/src/env/machines/laptop/bin/chat-grid-niri"

// ---------------------------------------------------------------------------
// The app workspaces: an app and a terminal side by side at the golden ratio,
// one named workspace each. The niri port of what i3 gets from `workspace N
// output` rules in i3/laptop.conf, `assign` rules in i3/autostart.conf, and
// three scripts (bin/chrome-workspace, bin/obsidian-grimoire, bin/ws8-spotify)
// -- all four are bin/app-workspace-niri here, because niri absorbs most of
// what those scripts were doing.
//
// Two things move out of the scripts and into this file:
//
//   * Output pinning. i3 cannot name a monitor it might not have, so
//     bin/monitor-output resolves each panel's connector from its EDID at run
//     time, publishes it as an X resource, and laptop.conf reads that back
//     with set_from_resource. niri matches outputs by EDID make/model/serial
//     natively, so each workspace just says where it lives.
//   * The golden ratio. i3 has to let the terminal tile wherever it lands and
//     then `resize set width 38 ppt` afterwards; niri takes a
//     default-column-width on the window rule, so a window is the right width
//     the moment it opens, including when it is relaunched by hand later.
//
// 1.618:1 is 61.8/38.2. bin/app-workspace-niri carries the same numbers for
// the one window no rule can match -- keep them in step.
//
// One limitation worth knowing, because i3 does NOT have it: open-on-output
// takes a single output, where i3's `workspace N output A B` takes a list and
// uses the first that exists. laptop.conf relies on that for the chat
// workspace (right monitor at home, top monitor at the parents' desk). The
// three workspaces below name the home desk's left monitor only, so at a desk
// without it niri falls back to its own choice of output rather than to a
// named second preference. That is a gap against the i3 setup, not a
// decision -- the fix, if it ever matters, is for bin/app-workspace-niri to
// move the workspaces itself the way bin/monitor-output does under X.

workspace "weftworks" {
    open-on-output "Samsung Electric Company LS32A70 HCPR901577"
}

workspace "personal" {
    open-on-output "Samsung Electric Company LS32A70 HCPR901577"
}

workspace "grimoire" {
    open-on-output "Samsung Electric Company LS32A70 HCPR901577"
}

// The built-in panel, named by connector rather than EDID: eDP-1 is stable
// in a way the dock's DisplayPorts are not, which is the same reason the
// output block at the top of this file can say "eDP-1" too.
workspace "spotify" {
    open-on-output "eDP-1"
}

// google-chrome honours --class for ordinary browser windows, so each
// profile arrives with its own app_id -- unlike the chat apps, which are
// --app= windows and take their app_id from the URL instead. kitty honours
// --class the same way. Both match the classes bin/app-workspace-niri
// launches them with, and the classes the i3 `assign` rules already use.
window-rule {
    match app-id=r#"^weftworks-chrome$"#
    open-on-workspace "weftworks"
    default-column-width { proportion 0.618; }
}

window-rule {
    match app-id=r#"^weftworks-chrome-term$"#
    open-on-workspace "weftworks"
    default-column-width { proportion 0.382; }
}

window-rule {
    match app-id=r#"^personal-chrome$"#
    open-on-workspace "personal"
    default-column-width { proportion 0.618; }
}

window-rule {
    match app-id=r#"^personal-chrome-term$"#
    open-on-workspace "personal"
    default-column-width { proportion 0.382; }
}

// Spotify reports "Spotify" capitalised, the same string as its X WM_CLASS.
window-rule {
    match app-id=r#"^Spotify$"#
    open-on-workspace "spotify"
    default-column-width { proportion 0.618; }
}

window-rule {
    match app-id=r#"^spotify-term$"#
    open-on-workspace "spotify"
    default-column-width { proportion 0.382; }
}

// The Grimoire's terminal, but NOT the Grimoire itself. Obsidian ignores
// --class under Wayland exactly as it does under X (tested on 1.13.7): every
// Obsidian window is "md.obsidian.Obsidian", so a rule matching it would drag
// every Obsidian window in the session onto this workspace. The Grimoire is
// found by PID instead and placed by bin/app-workspace-niri, which also has
// to set its column width because no rule can carry one for it. Same reason
// i3 cannot `assign` it either.
window-rule {
    match app-id=r#"^grimoire-term$"#
    open-on-workspace "grimoire"
    default-column-width { proportion 0.382; }
}

// Start all four at login, after the chat grid. --no-focus so login focus is
// left wherever it lands rather than being dragged to the last one to start,
// matching the --no-focus on every i3 autostart line this replaces.
spawn-sh-at-startup "$HOME/src/env/machines/laptop/bin/app-workspace-niri --all --no-focus"
