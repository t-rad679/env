// Saved i3 layout for the workspace 3 chat grid, applied by
// machines/laptop/bin/chat-grid via `i3-msg append_layout` BEFORE the four
// apps are launched. Each leaf below is a placeholder that swallows the first
// window matching its criteria, which is what pins each app to its corner:
//
//     Messenger | Messages
//     ----------+---------
//     Signal    | Discord
//
// Deliberately ONE root container (splitv) rather than two top-level rows: a
// workspace picks its own default orientation from the output's aspect ratio,
// so two top-level nodes would sit side by side on a landscape monitor
// instead of stacking. Nesting everything under an explicit splitv makes the
// 2x2 come out the same on any output.
//
// Criteria notes:
//   * Messenger and Messages are Chrome app windows, each on its own
//     --user-data-dir, which is what lets chat-grid pass --class. Match on
//     that class; the instance is Chrome's own "www.messenger.com" /
//     "messages.google.com", which it sets from the URL and ignores --name.
//   * Signal and Discord report lowercase classes ("signal", "discord"), not
//     the capitalised names their .desktop files use.
//
// This file is .json, not .conf, so the `include machines/$MACHINE_ROLE/i3/*.conf`
// in config/i3/config does not try to parse it as config.
{
    "layout": "splitv",
    "percent": 1.0,
    "type": "con",
    "nodes": [
        {
            "layout": "splith",
            "percent": 0.5,
            "type": "con",
            "nodes": [
                {
                    "type": "con",
                    "percent": 0.5,
                    "swallows": [
                        { "class": "^messenger-chrome$" }
                    ]
                },
                {
                    "type": "con",
                    "percent": 0.5,
                    "swallows": [
                        { "class": "^messages-chrome$" }
                    ]
                }
            ]
        },
        {
            "layout": "splith",
            "percent": 0.5,
            "type": "con",
            "nodes": [
                {
                    "type": "con",
                    "percent": 0.5,
                    "swallows": [
                        { "class": "^signal$" }
                    ]
                },
                {
                    "type": "con",
                    "percent": 0.5,
                    "swallows": [
                        { "class": "^discord$" }
                    ]
                }
            ]
        }
    ]
}
